{
  "name": "bizim-discord",
  "version": "4.0.0",
  "description": "Oyun ve görüntülü sohbet odaklı düşük gecikmeli iletişim uygulaması",
  "author": "UFUKtr08",
  "main": "electron-main.js",
  "scripts": {
    "server": "node server.js",
    "app": "electron .",
    "build-exe": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bizim.discord.app",
    "productName": "BizimDiscord",
    "files": [
      "electron-main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}